// Toiminnanohjausjärjestelmän tietomalli.
//
// Rakenne noudattaa rakennekaavion (docs/rakennekaavio.png) pääosioita
// (Projektit omana osionaan). Katso docs/ARKKITEHTUURI.md kaavion ja mallien välisestä
// vastaavuustaulukosta.
//
//   1. Asiakkuuksien hallinta  -> Customer, Offer
//      Projektit (pääobjekti)  -> Project, Building, BuildingPart, ProductionElement,
//                                 OrderConfirmation, ProcurementPlan, ProcurementItem,
//                                 ScheduleTask, ProjectMilestone, ProjectTodo, ProjectMember,
//                                 ProductionScheduleItem ("Tuotantoaikataulu projektit")
//   2. Tuotehallinta           -> Product, PriceList, PriceListItem,
//                                 StructureType, StructureMaterial (rakenneosakirjasto)
//
// Talotehtaan runko: Projekti -> Rakennus -> Määräluettelo (BuildingPart:
// rakenneosa × määrä) ja Elementti. Rakenneosan (StructureType: rakenne tai
// ostonimike) materiaaliluettelosta ja työtuntinormista
// johdetaan tarjouksen omakustannus, hankintojen materiaalitarve ja
// tuntimenekki. Reklamaatiot, tarkastukset ja piirustukset kohdistetaan
// rakennukseen tai elementtiin.
//   3. Reklamaatiot            -> Complaint
//   4. Laadunvarmistus         -> QaChecklist, QaChecklistItem, QaDocument
//   5. Tuotannon ohjaus        -> ProductionFolder, WorkOrder, Drawing
//
// HUOM: kaaviossa "Tuotantoaikataulu projektit" roikkuu Asiakkuuksien
// hallinta > Projektit -alla, EI Tuotannon ohjaus -osiossa. ProductionScheduleItem
// toteuttaa aiemmin Artifact-työkaluna rakennetun Tuotantoaikataulun
// laskentalogiikan (ks. src/lib/production-schedule.ts) - kentät
// seq/aloitus/siirto/tuntimenekki/tyontekijoita/tyopisteita/kesto vastaavat
// suoraan sitä työkalua, jotta data ja kaavat siirtyvät yksi yhteen. Tuotannon
// ohjaus -osio on tästä erillinen: se on Sharepoint-tuotantokansio (per
// projekti) työmääräimineen ja piirustuksineen.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 0. Henkilöt (henkilörekisteri, /henkilot)
//
// Henkilöille jaetaan projektien tehtäviä ja hankintoja, ja heistä
// kootaan projektiorganisaatio. Kirjautumista ei vielä ole; kun se
// lisätään (esim. NextAuth), se käyttää samoja rivejä.
// ============================================================

enum UserRole {
  ADMIN
  MYYNTI
  SUUNNITTELU
  HANKINTA
  TUOTANTO
  LAATU
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique // vapaaehtoinen, kunnes kirjautuminen lisätään
  name      String
  phone     String?
  role      UserRole @default(TUOTANTO)
  active    Boolean  @default(true) // ei-aktiivisille ei jaeta uusia tehtäviä
  createdAt DateTime @default(now())

  procurementItems ProcurementItem[]
  todos            ProjectTodo[]
  memberships      ProjectMember[]
}

// ============================================================
// 1. Asiakkuuksien hallinta
// ============================================================

model Customer {
  id           String   @id @default(cuid())
  name         String
  businessId   String? // Y-tunnus
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  offers                  Offer[]
  projects                Project[]
  productionScheduleItems ProductionScheduleItem[]
  complaints              Complaint[]

  @@map("customers")
}

enum OfferStatus {
  LUONNOS
  LAHETETTY
  HYVAKSYTTY
  HYLATTY
}

// Tarjoukset
model Offer {
  id          String      @id @default(cuid())
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  title       String
  status      OfferStatus @default(LUONNOS)
  amountCents Int?
  validUntil  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project   Project?
  // Tarjouksen sisältö: rakennukset ja niiden määräluettelot. "Muuta
  // projektiksi" liittää samat rakennukset projektiin (Building.projectId).
  buildings Building[]

  @@map("offers")
}

enum ProjectStatus {
  SUUNNITTELU
  KAYNNISSA
  VALMIS
  KESKEYTETTY
}

// Projektit (kaavion "Projekti 1", "Projekti 2", ... ovat tämän mallin rivejä)
model Project {
  id                   String        @id @default(cuid())
  customerId           String
  customer             Customer      @relation(fields: [customerId], references: [id])
  offerId              String?       @unique
  offer                Offer?        @relation(fields: [offerId], references: [id])
  name                 String
  status               ProjectStatus @default(SUUNNITTELU)
  // Yhteenvetosivu: yhteenveto koostetaan näistä kentistä + relaatioista,
  // ei erillistä taulua.
  description          String?
  promisedDeliveryDate DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  orderConfirmation       OrderConfirmation?
  procurementPlan         ProcurementPlan?
  milestones              ProjectMilestone[]
  scheduleTasks           ScheduleTask[]
  todos                   ProjectTodo[]
  members                 ProjectMember[]
  productionScheduleItems ProductionScheduleItem[]
  productionFolder        ProductionFolder?
  buildings               Building[]
  complaints              Complaint[]

  @@map("projects")
}

// Tilausvahvistus
model OrderConfirmation {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id])
  number      String   @unique
  confirmedAt DateTime @default(now())
  fileUrl     String?
  notes       String?

  @@map("order_confirmations")
}

// Hankintasuunnitelma
model ProcurementPlan {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id])
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ProcurementItem[]

  @@map("procurement_plans")
}

// Hankintarivin tyyppi (Excelin "Pääryhmä").
enum ProcurementKind {
  TYOSUORITE
  MATERIAALI
}

// Hankinnan vaihe. Rivi etenee järjestyksessä AINEISTO -> ... -> VALMIS.
// Jokaisella vaiheella on takaraja, joka lasketaan toimituspäivästä
// taaksepäin (ks. src/lib/hankinta.ts).
enum ProcurementPhase {
  AINEISTO // aineiston keräys
  PYYNTO // tarjouspyyntö lähetettävä
  TARJOUS // tarjouksia odotetaan
  VERTAILU // tarjousten vertailu
  SOPIMUS // urakkaneuvottelut ja sopimus
  TOIMITUS // sopimus tehty, toimitusta odotetaan
  VALMIS // toimitettu
  EI_TARVITA
}

// Hankintasuunnitelman rivi. Rakenne vastaa projektinhallinnan Excelin
// Hankintasuunnitelma-välilehteä: toimituspäivä tulee projektiaikataulun
// tehtävän (scheduleTaskCode) aloituksesta, ja vaiheiden takarajat lasketaan
// siitä taaksepäin vaiheiden kestoilla (kalenteripäiviä).
model ProcurementItem {
  id                String           @id @default(cuid())
  procurementPlanId String
  procurementPlan   ProcurementPlan  @relation(fields: [procurementPlanId], references: [id], onDelete: Cascade)
  kind              ProcurementKind  @default(MATERIAALI)
  littera           String? // esim. "3300"
  description       String // Excelin "Tehtävä"
  quantity          Float            @default(1)
  unit              String           @default("kpl")
  scheduleTaskCode  String? // projektiaikataulun tehtävätunnus, esim. "T3"
  neededBy          DateTime? // käsin annettu toimituspäivä, jos aikataulutehtävää ei ole
  materialDays      Int              @default(1) // aineiston keräys
  requestDays       Int              @default(5) // pyyntöaika
  comparisonDays    Int              @default(1) // vertailuaika
  negotiationDays   Int              @default(2) // urakkaneuvottelut
  deliveryDays      Int              @default(14) // toimitusaika vrk
  phase             ProcurementPhase @default(AINEISTO)
  supplier          String? // urakoitsija / toimittaja
  agreedDelivery    DateTime? // sovittu toimituspäivä
  costCents         Int? // kustannus alv 0 %
  paymentInfo       String? // lisätieto maksuihin
  notes             String?
  assigneeId        String?
  assignee          User?            @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  // Nimike, jos rivi on luotu rakenteiden materiaalitarpeesta (tai liitetty käsin).
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Rakenneosa, jos rivi on luotu kiinteähintaisista määräluettelon riveistä.
  structureTypeId   String?
  structureType     StructureType?   @relation(fields: [structureTypeId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([assigneeId])
  @@index([productId])
  @@map("procurement_items")
}

// Projektiaikataulun tehtävä. Vastaa projektinhallinnan Excelin
// aikataulu-välilehteä: tehtävällä on tunnus (T1, T2, ...) ja edeltävä
// tehtävä (tunnuksena). Aloitus on joko kiinteä tai edeltäjän ennuste +
// siirto kalenteripäivää, ja ennuste lasketaan samalla
// WORKDAY.INTL(aloitus, kesto, 1) - 1 -kaavalla kuin tuotantoaikataulussa
// (ks. src/lib/projektiaikataulu.ts). Edeltäjä on tunnus eikä viiteavain,
// jotta tehtäviä voi tuoda missä järjestyksessä tahansa.
//
// EI sama kuin ProductionScheduleItem (koko tuotannon Gantt).
model ScheduleTask {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code            String // tehtävätunnus, esim. "T1"
  title           String
  category        String? // luokka, esim. "Työsuorite"
  contractor      String? // urakoitsija
  mainGroup       Int? // pääryhmä
  predecessorCode String? // "edellyttää tehtävät"
  offsetDays      Int       @default(0) // siirto, kalenteripäivää
  crew            Int? // miesvahvuus
  progress        Int       @default(0) // valmiusaste 0-100
  fixedStart      DateTime? // kiinteä aloitus (ketjun alku)
  durationDays    Int       @default(1) // kesto työpäivinä
  seq             Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([projectId, code])
  @@map("schedule_tasks")
}

enum TodoStatus {
  AVOIN
  KESKEN
  VALMIS
}

enum TodoArea {
  LUVITUS
  SUUNNITTELU
  HANKINTA
  MUU
}

// Projektin oma tehtävä tehtäväluettelossa (hankintarivien lisäksi), esim.
// luvat ja suunnittelukatselmukset. Takaraja on annettu päivä tai
// linkitetyn aikataulutehtävän aloitus.
model ProjectTodo {
  id               String     @id @default(cuid())
  projectId        String
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  notes            String?
  area             TodoArea   @default(SUUNNITTELU)
  status           TodoStatus @default(AVOIN)
  dueDate          DateTime?
  scheduleTaskCode String?
  assigneeId       String?
  assignee         User?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([assigneeId])
  @@map("project_todos")
}

// Projektiorganisaatio: kuka vastaa mistäkin (Excelin yhteenveto-välilehti,
// esim. "Suunnittelu/hankinta: Mikko").
model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // esim. "Hankekehitys/luvitus", "Suunnittelu/hankinta", "Tuotanto"

  @@unique([projectId, userId, role])
  @@map("project_members")
}

// Virstanpylväät: asiakkaalle näkyvät projektin ylätason päivämäärät.
// Näytetään Projektiaikataulu-sivulla tehtäväaikataulun alla. Eri asia
// kuin ProductionScheduleItem (koko tuotannon Gantt).
model ProjectMilestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?
  done      Boolean   @default(false)
  seq       Int       @default(0)

  @@map("project_milestones")
}

// ============================================================
// 2. Tuotehallinta
// ============================================================

// Nimikkeistö
model Product {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  unit        String   @default("kpl")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceListItems     PriceListItem[]
  structureMaterials StructureMaterial[]
  procurementItems   ProcurementItem[]
  buildingParts      BuildingPart[]
  pohjaRivit         LaskentapohjaRivi[]

  @@map("products")
}

// Hinnastot
model PriceList {
  id             String    @id @default(cuid())
  name           String
  validFrom      DateTime  @default(now())
  validTo        DateTime?
  // Tehtaan työtunnin hinta rakenteiden kustannuslaskentaan (sentteinä).
  laborHourCents Int?
  createdAt      DateTime  @default(now())

  items PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  id             String    @id @default(cuid())
  priceListId    String
  priceList      PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  unitPriceCents Int
  currency       String    @default("EUR")

  @@unique([priceListId, productId])
  @@map("price_list_items")
}

// ============================================================
// 3. Reklamaatiot
// ============================================================

enum ComplaintStatus {
  AVOIN
  SELVITYKSESSA
  RATKAISTU
  HYLATTY
}

model Complaint {
  id          String             @id @default(cuid())
  customerId  String
  customer    Customer           @relation(fields: [customerId], references: [id])
  title       String
  description String
  status      ComplaintStatus    @default(AVOIN)
  createdAt   DateTime           @default(now())
  resolvedAt  DateTime?
  // Kohdistus: mihin projektiin, rakennukseen ja elementtiin reklamaatio
  // liittyy. Kaikki vapaaehtoisia, koska reklamaatio voi tulla ennen kuin
  // kohde on tiedossa. Tarkin annettu taso ratkaisee.
  projectId   String?
  project     Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  buildingId  String?
  building    Building?          @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  elementId   String?
  element     ProductionElement? @relation(fields: [elementId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([buildingId])
  @@map("complaints")
}

// ============================================================
// 4. Laadunvarmistus
// ============================================================

// Tarkastuslistat. Pohja (isTemplate) on vakiolista, josta kopioidaan
// tarkastettava lista rakennukselle tai elementille. Pohjan kohtiin ei
// kirjata tuloksia.
model QaChecklist {
  id         String             @id @default(cuid())
  title      String
  isTemplate Boolean            @default(false)
  buildingId String?
  building   Building?          @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  elementId  String?
  element    ProductionElement? @relation(fields: [elementId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  items QaChecklistItem[]

  @@index([buildingId])
  @@map("qa_checklists")
}

model QaChecklistItem {
  id          String      @id @default(cuid())
  checklistId String
  checklist   QaChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  label       String
  seq         Int         @default(0)
  passed      Boolean?
  note        String?

  @@map("qa_checklist_items")
}

// Dopit (dokumentit)
model QaDocument {
  id         String    @id @default(cuid())
  title      String
  fileUrl    String?
  category   String?
  // Rakennuskohtainen dokumentti (esim. DoP tai luovutusaineisto); tyhjä = yleinen.
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@map("qa_documents")
}

// ------------------------------------------------------------
// 1b. Tuotantoaikataulu projektit (Asiakkuuksien hallinta > Projektit alla)
// ------------------------------------------------------------

// Tuotantoaikataulun rivit - sama tietomalli ja laskentalogiikka kuin
// aiemmin rakennetussa Artifact-työkalussa (src/lib/production-schedule.ts).
// Tämä EI ole Tuotannon ohjaus -osiota, vaan kaavion "Tuotantoaikataulu
// projektit" -solmu Projektit-haaran alla.
model ProductionScheduleItem {
  id            String    @id @default(cuid())
  seq           Int
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id])
  // Rakennus, jota rivi valmistaa. Ei vaikuta laskentaan.
  buildingId    String?
  building      Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  tilaaja       String // vapaateksti-nimi, jos ei linkitetä Customer-tauluun
  projekti      String
  rakennuksia   Int       @default(1)
  luvattu       DateTime?
  aloitus       DateTime? // kiinteä aloitus (vain ketjun ensimmäisellä rivillä pakollinen)
  siirto        Int       @default(0) // kalenteripäivää edellisen rivin ennusteesta
  tuntimenekki  Float
  tyontekijoita Int
  tyopisteita   Int       @default(1)
  kesto         Int // työpäivää - AINOA aikataulua ohjaava kestoarvo
  valmiusaste   Int? // 0-100, null = ei kirjattu
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([seq])
  @@map("production_schedule_items")
}

// ============================================================
// 5. Tuotannon ohjaus
// ============================================================

// Sharepoint tuotantokansio: yksi per projekti, ulkoinen synkronointipiste.
model ProductionFolder {
  id            String    @id @default(cuid())
  projectId     String    @unique
  project       Project   @relation(fields: [projectId], references: [id])
  sharepointUrl String?
  syncedAt      DateTime?

  workOrders WorkOrder[]
  drawings   Drawing[]

  @@map("production_folders")
}

// Työmääräimet
model WorkOrder {
  id                 String             @id @default(cuid())
  productionFolderId String
  productionFolder   ProductionFolder   @relation(fields: [productionFolderId], references: [id], onDelete: Cascade)
  number             String
  description        String?
  hoursEstimated     Float?
  hoursActual        Float?
  buildingId         String?
  building           Building?          @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  elementId          String?
  element            ProductionElement? @relation(fields: [elementId], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())

  @@map("work_orders")
}

// Piirustukset
model Drawing {
  id                 String             @id @default(cuid())
  productionFolderId String
  productionFolder   ProductionFolder   @relation(fields: [productionFolderId], references: [id], onDelete: Cascade)
  title              String
  revision           String             @default("A")
  fileUrl            String?
  buildingId         String?
  building           Building?          @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  elementId          String?
  element            ProductionElement? @relation(fields: [elementId], references: [id], onDelete: SetNull)
  uploadedAt         DateTime           @default(now())

  @@map("drawings")
}

// ============================================================
// 2b. Rakenneosakirjasto (Tuotehallinta > Rakenneosat)
//
// Käyttöliittymässä "rakenneosa" = StructureType ja rakennuksen
// "määräluettelon rivi" = BuildingPart. Mallien nimet ovat historiallisia.
//
// Rakenneosa on joko talotehtaan oma vakiorakenne (kind = RAKENNE, esim.
// "US-1 ulkoseinä 200 mm", materiaaliluettelo) tai valmiina ostettava
// nimike (kind = OSTONIMIKE, esim. ilmalämpöpumppu tai ikkuna: täsmälleen
// yksi materiaalirivi, nimike × 1). Jokainen rakennus kootaan näistä:
// määräluettelon rivi = rakenneosa × määrä. Materiaaliluettelosta ja
// työtuntinormista lasketaan materiaalitarve, tuntimenekki ja omakustannus
// (src/lib/rakenteet.ts), ja ostonimikkeet päätyvät materiaalitarpeen
// kautta hankintasuunnitelmaan.
// ============================================================

enum StructureCategory {
  ULKOSEINA
  VALISEINA
  ALAPOHJA
  VALIPOHJA
  YLAPOHJA
  KATTO
  TILAELEMENTTI
  IKKUNA
  OVI
  TEKNIIKKA
  KALUSTE
  MUU
}

enum StructureKind {
  RAKENNE // oma valmistus: materiaaliluettelo + työtunnit
  OSTONIMIKE // ostetaan valmiina: yksi nimike, työtunnit = asennus/käsittely
}

model StructureType {
  id                String            @id @default(cuid())
  code              String            @unique // esim. "US-1"
  name              String
  kind              StructureKind     @default(RAKENNE)
  category          StructureCategory @default(MUU)
  unit              String            @default("m2") // m2, jm, kpl
  description       String?
  // Työtuntinormi: tehtaan työtunteja per yksikkö.
  laborHoursPerUnit Float             @default(0)
  // BIM-mallin tyyppinimi (esim. IFC-tyypin nimi tai Tekla/Revit-tyyppi),
  // jolla mallin määräluettelon rivi tunnistetaan tähän rakenneosaan.
  bimTypeName       String?           @unique
  active            Boolean           @default(true)
  // Littera (Talo 80), jonka mukaan rakennusten määräluettelot ja
  // hankinnat ryhmitellään.
  litteraId         String?
  littera           Littera?          @relation(fields: [litteraId], references: [id], onDelete: SetNull)
  // Kiinteä yksikköhinta senteissä (desimaalit sallittu, koska laskurin
  // yksikköhinnat ovat esim. 19,684 €). Jos annettu, rivin hinta on
  // määrä × tämä eikä materiaaliluettelosta laskettu.
  unitPriceCents    Float?
  // Kiinteän hinnan kustannuslaji (tehdastyö ja aliurakka eritellään).
  costType          CostType          @default(MATERIAALI)
  // Tarjouslaskurin laskentarivin avain (src/lib/tarjouslaskenta.ts), esim. "3500-01".
  laskuriAvain      String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  materials        StructureMaterial[]
  parts            BuildingPart[]
  elements         ProductionElement[]
  procurementItems ProcurementItem[]
  pohjaRivit       LaskentapohjaRivi[]

  @@index([litteraId])
  @@map("structure_types")
}

enum CostType {
  MATERIAALI // materiaali tai osto
  TEHDASTYO // tehtaan oma työ (laskurin TEH-TYÖ)
  ALIURAKKA // aliurakka (laskurin ALIURAKKA)
}

// Littera (Talo 80 -nimikkeistö), esim. "3500 Elementtituotanto". Rakenneosat,
// määräluettelot ja hankinnat lajitellaan litteroittain. Tarjouslaskurin
// litterat luodaan toiminnolla "Tuo tarjouslaskurin laskentarivit".
model Littera {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  structureTypes     StructureType[]
  buildingParts      BuildingPart[]
  laskentapohjaRivit LaskentapohjaRivi[]

  @@map("litterat")
}

// Tarjouslaskentapohja: tallennettu laskenta, jonka voi ottaa rakennuksen
// pohjaksi. Sisältää määräluettelon rivit (rakenneosat, nimikkeet ja
// vapaat rivit litteroineen), katteen ja tarvittaessa laskurin syötteen.
model Laskentapohja {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  katePct       Float?
  laskentaSyote Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rivit LaskentapohjaRivi[]

  @@map("laskentapohjat")
}

model LaskentapohjaRivi {
  id              String         @id @default(cuid())
  pohjaId         String
  pohja           Laskentapohja  @relation(fields: [pohjaId], references: [id], onDelete: Cascade)
  structureTypeId String?
  structureType   StructureType? @relation(fields: [structureTypeId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  description     String?
  unit            String?
  unitPriceCents  Float?
  litteraId       String?
  littera         Littera?       @relation(fields: [litteraId], references: [id], onDelete: SetNull)
  costType        CostType?
  quantity        Float
  location        String?
  notes           String?
  seq             Int            @default(0)

  @@index([pohjaId])
  @@map("laskentapohja_rivit")
}

// Rakenneosan materiaaliluettelo: nimike × menekki per rakenneosan yksikkö.
// Ostonimikkeellä täsmälleen yksi rivi: nimike × 1.
model StructureMaterial {
  id              String        @id @default(cuid())
  structureTypeId String
  structureType   StructureType @relation(fields: [structureTypeId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantityPerUnit Float // nimikkeen yksikköä per rakenneosan yksikkö
  wastePct        Float         @default(0) // hukka-%
  seq             Int           @default(0)
  notes           String?

  @@unique([structureTypeId, productId])
  @@map("structure_materials")
}

// ============================================================
// 1c. Rakennukset (Projektit > projekti > Rakennukset)
//
// Projektin toimitettava kohde. Rakennus syntyy tarjoukselle (offerId) ja
// liitetään projektiin, kun tarjous muutetaan projektiksi (projectId).
// Sen jälkeen offerId jää historiaksi. Tuotanto, laadunvarmistus,
// reklamaatiot ja piirustukset kohdistetaan rakennukseen tai sen
// elementtiin.
// ============================================================

enum BuildingStatus {
  SUUNNITTELU
  VALMISTUKSESSA
  TOIMITETTU
  VALMIS
}

model Building {
  id              String         @id @default(cuid())
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  offerId         String?
  offer           Offer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)
  code            String // tunnus projektin sisällä, esim. "A" tai "MOD1"
  name            String?
  buildingType    String? // vapaa kuvaus, esim. "Paritalo", "Majoitusmoduuli"
  grossAreaM2     Float?
  address         String?
  status          BuildingStatus @default(SUUNNITTELU)
  plannedDelivery DateTime?
  deliveredAt     DateTime?
  // BIM: linkki malliin (IFC-tiedosto, Trimble Connect, Dalux tms.) ja
  // IfcBuilding-olion GlobalId, jolla mallin tiedot kohdistetaan rakennukseen.
  bimModelUrl     String?
  // Tarjouslaskurin syöte (src/lib/tarjouslaskenta.ts Syote), tallennetaan
  // kun laskenta viedään rakennuksen määräluetteloon.
  laskentaSyote   Json?
  // Tarjouslaskennan kate % (laskuri tai manuaalinen); tyhjä = 25 %.
  katePct         Float?
  bimGuid         String?
  seq             Int            @default(0)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  parts                   BuildingPart[]
  elements                ProductionElement[]
  complaints              Complaint[]
  checklists              QaChecklist[]
  documents               QaDocument[]
  workOrders              WorkOrder[]
  drawings                Drawing[]
  productionScheduleItems ProductionScheduleItem[]

  @@unique([projectId, code])
  @@unique([offerId, code])
  @@map("buildings")
}

enum QuantitySource {
  KASIN
  BIM
  LASKURI // tarjouslaskurin laskema; korvautuu, kun laskenta tallennetaan uudelleen
}

// Määräluettelon rivi: rakennuksessa on tätä rakenneosaa tämä määrä. Määrät
// syötetään käsin tai tuodaan BIM-mallin määräluettelosta (source = BIM,
// bimGuid = mallin olion GlobalId, jolla uusintatuonti päivittää rivin).
//
// Rivi on yksi kolmesta (tarjouslaskennan manuaaliset rivit):
//  - rakenneosa (structureTypeId): hinta rakenneosalta
//  - nimike (productId): hinta hinnastosta, näkyy materiaalitarpeessa
//  - vapaa rivi (kumpikaan ei annettu): kuvaus ja yksikköhinta pakollisia
// Rivikohtaiset kentät (description, unitPriceCents, litteraId, costType)
// korvaavat rakenneosan tai nimikkeen tiedot, jos ne annetaan.
model BuildingPart {
  id              String         @id @default(cuid())
  buildingId      String
  building        Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  structureTypeId String?
  structureType   StructureType? @relation(fields: [structureTypeId], references: [id], onDelete: Restrict)
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)
  description     String? // vapaan rivin nimi tai lisäkuvaus
  unit            String? // vapaan rivin yksikkö (muuten rakenneosan tai nimikkeen)
  unitPriceCents  Float? // rivin oma yksikköhinta senteissä; korvaa muun hinnan
  litteraId       String?
  littera         Littera?       @relation(fields: [litteraId], references: [id], onDelete: SetNull)
  costType        CostType? // rivin oma kustannuslaji; muuten rakenneosan
  quantity        Float
  location        String? // sijainti, esim. "1. krs" tai "Pääty A"
  source          QuantitySource @default(KASIN)
  bimGuid         String?
  seq             Int            @default(0)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([buildingId, bimGuid])
  @@index([buildingId])
  @@map("building_parts")
}

enum ElementStatus {
  SUUNNITTEILLA
  VALMISTUKSESSA
  VALMIS
  TOIMITETTU
  ASENNETTU
}

// Elementti tai tilaelementti (moduuli): tehtaan valmistama ja toimittama
// yksikkö, jolla on oma tunnus. Työmääräimet, piirustukset, tarkastukset ja
// reklamaatiot voi kohdistaa elementtiin.
model ProductionElement {
  id              String         @id @default(cuid())
  buildingId      String
  building        Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  code            String // elementtitunnus, esim. "A-US-01"
  structureTypeId String?
  structureType   StructureType? @relation(fields: [structureTypeId], references: [id], onDelete: SetNull)
  description     String?
  quantity        Float? // elementin koko rakenneosan yksikössä (esim. m2)
  status          ElementStatus  @default(SUUNNITTEILLA)
  plannedDate     DateTime?
  completedAt     DateTime?
  bimGuid         String?
  seq             Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  complaints Complaint[]
  checklists QaChecklist[]
  workOrders WorkOrder[]
  drawings   Drawing[]

  @@unique([buildingId, code])
  @@map("production_elements")
}

// ============================================================
// 6. Tiedonsiirto (tuonti ja vienti)
//
// Poikkileikkaava työkalu, joka ei ole kaavion solmu: sillä tuodaan ja
// viedään kaikkien osioiden tietoja (CSV, Excel, JSON). Ks.
// src/lib/tiedonsiirto/ ja /tiedonsiirto.
// ============================================================

enum DataTransferDirection {
  TUONTI
  VIENTI
}

// Tuonti- ja vientiloki: yksi rivi per tallennettu tuonti tai vienti.
// Esikatseluja ei kirjata.
model DataTransferLog {
  id        String                @id @default(cuid())
  direction DataTransferDirection
  target    String // kohteen avain, esim. "asiakkaat" tai "kaikki"
  format    String // csv | xlsx | json
  fileName  String?
  created   Int                   @default(0)
  updated   Int                   @default(0)
  skipped   Int                   @default(0)
  failed    Int                   @default(0)
  createdAt DateTime              @default(now())

  @@index([createdAt])
  @@map("data_transfer_logs")
}
