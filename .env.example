# Kopioi tämä tiedostoksi ".env" ja täytä oikeat arvot paikallista kehitystä varten.
# docker-compose.yml nostaa Postgresin, joka vastaa oletusarvoja alla.

DATABASE_URL="postgresql://erp:erp@localhost:5432/erp?schema=public"

